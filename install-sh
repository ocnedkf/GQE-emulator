#!/data/data/com.termux/files/usr/bin/bash

if [ "$(uname -m)" != "aarch64" ]; then
    echo -e "\033[31mERROR:The GQE-emulator only supports the ARM64 architecture\033[0m"
    echo -e "\033[31mPlease ensure that your device meets the requirements of Termux\033[0m"
    exit 1
fi

export HOME="/data/data/com.termux/files/home"

FREE_KB=$(df "$HOME" | awk 'NR==2 {print $4}')
if [ "$FREE_KB" -lt 5767168 ]; then
    echo -e "\033[31mERROR:Insufficient storage space, at least 5.5GB of free space is required\033[0m"
    exit 1
fi

export PREFIX="/data/data/com.termux/files/usr"

download_file() {
    local url="$1"
    local hash_value="$2"
    local file_name="$3"
    local echo_file_name="$4"
    echo -e "\nDownloading $echo_file_name...\n"
    rm -f "$PREFIX/tmp/$file_name"

    if ! wget --quiet --show-progress -O "$PREFIX/tmp/$file_name" "$url"; then
        echo -e "\n\033[31mERROR: Failed to download $echo_file_name, check network!\033[0m\n"
        exit 1
    fi

    sha256sum --status -c <<< "$hash_value  $PREFIX/tmp/$file_name"
    if [ $? -ne 0 ]; then
        echo -e "\n\033[31mERROR: Hash verification failed for $file_name. Please check the file integrity.\033[0m\n"
        rm -f "$PREFIX/tmp/$file_name"
        exit 1
    fi
}

extract_file() {
    local echo_file_name="$1"
    local file_name="$2"
    local dest_dir="$3"
    echo -e "\nUnpacking $echo_file_name...\n"
    mkdir -p "$dest_dir"
    if tar -xJf $PREFIX/tmp/$file_name -C "$dest_dir" >/dev/null 2>&1; then
        rm -f "$PREFIX/tmp/$file_name"
    else
        echo -e "\n\033[31mERROR: Failed to unpack $file_name. Please try again.\033[0m\n"
        exit 1
    fi
}

judge_init_error(){
    if [ $? -ne 0 ]; then
        echo -e "\033[31mError: Initialization failed, please try again\033[0m"
        rm -f initialization-sh
        exit 1
    fi
}

setup_area_files(){
    for area in "$@"; do
        grun $PREFIX/glibc/bin/localedef -f UTF-8 -c -i $area "$GQE_DATA/locale/${area}.UTF-8"
    done
}

clear

echo -e "Welcome to the GQE installation script\n"
echo -e "We will now begin the installation process\n"
sleep 1

echo -e "Please grant storage permissions\n"
echo -e "If already granted, this can be ignored\n"
termux-setup-storage >/dev/null 2>&1 & sleep 0
PID=$!
wait $PID
if [ ! -e "$HOME/storage" ]; then
    echo -e "\033[31mERROR:Failed to check the directory , Please ensure that you have granted storage permissions\033[0m\n"
    exit 1
fi

echo -e "Updating termux package...\n"
apt-get clean
apt-get update >/dev/null 2>&1
apt-get -y --with-new-pkgs -o Dpkg::Options::="--force-confdef" upgrade >/dev/null 2>&1

echo "Installing necessary..."
pkg install x11-repo glibc-repo -y &>/dev/null
pkg install virglrenderer pulseaudio termux-x11-nightly glibc-runner alsa-lib-glibc freetype-glibc libpulse-glibc libx11-glibc libxcb-glibc libxext-glibc libxft-glibc libdrm-glibc libffi-glibc libicu-glibc libpciaccess-glibc libxml2-glibc libxshmfence-glibc libxi-glibc libxrandr-glibc vulkan-icd-loader-glibc tar xz-utils wget libepoxy-glibc libxkbcommon-glibc libxcursor-glibc libxcomposite-glibc libxinerama-glibc libmount-glibc libthai-glibc libgraphite-glibc libpixman-glibc libjpeg-turbo-glibc -y &>/dev/null
pkg remove mesa-glibc -y &>/dev/null

export GQE_DATA="$HOME/.gqe-data-v0.4"
export WINEPREFIX="$GQE_DATA/.wine"
export GQE_CONFIG_PATH=$HOME/storage/shared/.gqe-start
export WINEARCH=win64
export BOX64_PATH="$GQE_DATA/wine/bin:$GQE_DATA/box64/bin:$PREFIX/glibc/bin"
export BOX64_LD_LIBRARY_PATH="$GQE_DATA/wine/lib:$GQE_DATA/lib:$GQE_DATA/box64/lib/box64-x86_64-linux-gnu"
export BOX64="$GQE_DATA/box64/bin/box64"
export GQE_CONFIG_PATH="$HOME/storage/shared/.gqe-start"

cd $HOME

# download and extract necessary files
download_file https://github.com/ocnedkf/GQE-emulator/releases/download/v0.2-beta/lib.tar.xz "bbc45aee29be45e8f90672e4cfac4f3d22baff20ca05131b44b38c5733dcd9e2" "lib.tar.xz" "additional dependencies"
extract_file "additional dependencies" "lib.tar.xz" "$GQE_DATA/lib"

echo -e "Repairing the symbolic link..."
download_file https://raw.githubusercontent.com/ocnedkf/GQE-emulator/refs/heads/v0.4-beta/repair-symlinks.sh "FC8D13E6B29850BE72A709F5C9BD75B286893610171D85A417E72955176B4A8C" "repair-symlinks.sh" "Fix Script"
mv $PREFIX/tmp/repair-symlinks.sh .
chmod +x repair-symlinks.sh
./repair-symlinks.sh

# download and extract box64
download_file https://github.com/ocnedkf/GQE-emulator/releases/download/v0.2-beta/box64.tar.xz "6ff2d48380f5a76e2f03c4023e71e1a1d4e5b84ca1948e59cb6f8b76fdd165a9" "box64.tar.xz" "Box64"
extract_file "Box64" box64.tar.xz "$GQE_DATA/box64"

setup_gqe_scripts() {
    local init_url="$1"
    local init_hash="$2"
    local start_url="$3"
    local start_hash="$4"

    # Initialization script
    download_file "$init_url" "$init_hash" "initialization-sh" "初始化脚本"
    clear
    echo -e "正在初始化 Wine...\n"
    mv "$PREFIX/tmp/initialization-sh" .
    chmod +x initialization-sh
    source ./initialization-sh
    judge_init_error

    # Startup script
    download_file "$start_url" "$start_hash" "start-gqe" "启动脚本"
    mv "$PREFIX/tmp/start-gqe" "$PREFIX/bin/start-gqe"
    chmod +x "$PREFIX/bin/start-gqe"
}

while true; do
    echo -e "\nChoose Wine version... (Input number then press Enter)\n"
    echo "1) Wine-9.16-custom (Old Version)"
    echo -e "2) Proton-Wine-11.0 (Testing)\n"

    read gqe   
    if [ "$gqe" = "1" ]; then
        # download and extract wine
        download_file https://github.com/ocnedkf/GQE-emulator/releases/download/v0.1-beta/winewow64.tar.xz "88d1d73569e869ccdb51e1c25f5d70963a23344ea9be188e5442995d70492484" "winewow64.tar.xz" "Wine"
        extract_file "Wine" "winewow64.tar.xz" "$GQE_DATA/wine"
    
        setup_gqe_scripts \
            "https://raw.githubusercontent.com/ocnedkf/GQE-emulator/refs/heads/v0.4.1-beta/initialization-wine-sh" \
            "a12ac7eaa21593cbc6e68f7f88265d2afec8822f6e884d476812bcc20aa72f47" \
            "https://raw.githubusercontent.com/ocnedkf/GQE-emulator/refs/heads/v0.4.1-beta/start-gqe-wine" \
            "FE10F7FC2A4E131AE507C4D9D814E2A91FF8B404223507B551046270691C2ED4"
        break
    elif [ "$gqe" = "2" ]; then
        # download and extract proton-wine
        download_file https://github.com/ocnedkf/GQE-emulator/releases/download/v0.2-beta/proton-wine-11.0-wow64.tar.xz "a937c76416c261bcbdbd9b5b6c3dd8142fdaed7060b171e2cb65bc4188d4a1ef" "proton-wine-11.0-wow64.tar.xz" "Proton-Wine"
        extract_file "Proton-Wine" "proton-wine-11.0-wow64.tar.xz" "$GQE_DATA/wine"
        
        setup_gqe_scripts \
            "https://raw.githubusercontent.com/ocnedkf/GQE-emulator/refs/heads/v0.4.1-beta/initialization-proton-sh" \
            "a12ac7eaa21593cbc6e68f7f88265d2afec8822f6e884d476812bcc20aa72f47" \
            "https://raw.githubusercontent.com/ocnedkf/GQE-emulator/refs/heads/v0.4.1-beta/start-gqe-proton" \
            "3C8A2E0A11BD5D41B5BFEEEDE3A7A33A724B5408776AADDF3895E0F774253C84"
        break
    else
        clear
        echo "Wrong input, choose again..."
    fi
done

echo -e "\nConfiguring area files...\n"
rm -rf "$GQE_DATA/locale"
mkdir -p "$GQE_DATA/locale"
setup_area_files en_US ja_JP zh_CN zh_TW C de_DE ko_KR ru_RU

# download and extract fonts
download_file https://github.com/ocnedkf/GQE-emulator/releases/download/v0.1-beta/fonts.tar.xz "c51a887f91f3b64cc218d417bdcaef84c93061c4451df79cff4ce9f631413254" "fonts.tar.xz" "Fonts"
extract_file "Fonts" "fonts.tar.xz" "$GQE_DATA/wine/share/wine/fonts"

# download and set up GQE termination script
download_file https://raw.githubusercontent.com/ocnedkf/GQE-emulator/refs/heads/v0.4.1-beta/kill-gqe "a465215221b89a7da19a6cabe435af50374e11766edcfc7bf88b29726e53194f" "kill-gqe" "Termination Script"
mv $PREFIX/tmp/kill-gqe $PREFIX/bin/kill-gqe
chmod +x $PREFIX/bin/kill-gqe

echo -e "\nStarting to launch GQE, Next time use 'start-gqe' command to run it"
sleep 2

start-gqe

clear
rm -f "$0"
