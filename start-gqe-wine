#!/data/data/com.termux/files/usr/bin/env bash

trap 'clear; echo "Closing..."; if ps a | grep -q "[w]ine"; then /data/data/com.termux/files/usr/bin/kill-gqe; fi; exit 130' 2 3

export HOME="/data/data/com.termux/files/home"
if [ ! -d "$HOME/storage" ]; then
    echo -e "External storage not found! Check your storage permissions"
    exit 1
fi

export PREFIX="/data/data/com.termux/files/usr"
download_file() {
    local url="$1"
    local hash_value="$2"
    local file_name="$3"
    local echo_file_name="$4"
    echo -e "\nDownloading $echo_file_name...\n"
    rm -f "$PREFIX/tmp/$file_name"

    if ! wget --quiet --show-progress -c -O "$PREFIX/tmp/$file_name" "$url"; then
        echo -e "\n\033[31mError: Failed to download $echo_file_name, check your network!\033[0m\n"
        exit 1
    fi

    sha256sum --status -c <<< "$hash_value  $PREFIX/tmp/$file_name"
    if [ $? -ne 0 ]; then
        echo -e "\n\033[31mError: Verification of $file_name failed, please check the file's integrity\033[0m\n"
        rm -f "$PREFIX/tmp/$file_name"
        exit 1
    fi
}

extract_file() {
    local echo_file_name="$1"
    local file_name="$2"
    local dest_dir="$3"
    echo -e "\nExtracting $echo_file_name...\n"
    mkdir -p "$dest_dir"
    if tar -xJf "$PREFIX/tmp/$file_name" -C "$dest_dir" >/dev/null 2>&1; then
        rm -f "$PREFIX/tmp/$file_name"
    else
        echo -e "\n\033[31mError: Failed to extract $file_name; please try again\033[0m\n"
        exit 1
    fi
}

show_info() {
    cat <<-EOF
==================== Introduction ====================

GQE-emulator by ocnedkf

GQE-emulator is an emulator for running Windows x86_64 programs

For details, see: https://github.com/ocnedkf/GQE-emulator/tree/v0.4-beta
EOF
}

show_version() {
    echo "v0.4-beta"
    exit 0
}

show_help() {
    cat <<'EOF'
==================== Usage ====================

usage : start-gqe [option]

        start-gqe                Start GQE normally
        start-gqe -v/--version   Print version information and exit
        start-gqe -h/--help      Print help and introduction, then exit
        start-gqe -f/--fix       Try to repair the Wine prefix
        start-gqe -na/--no-audio Disable audio when starting GQE
        start-gqe -wv/--with-vnc Start GQE with the VNC service
        start-gqe -ov/--only-vnc Start GQE with only the VNC service
        start-gqe -s/--settings  Open the GQE settings menu
EOF
    show_info
}

reinit() {
    download_file "https://raw.githubusercontent.com/ocnedkf/GQE-emulator/refs/heads/v0.4-beta/initialization-wine-sh" "5BE3933470C4C5F3C0BFA87077FC74B28A89A2CC662EF72B254BE7DD7C2A694B" "initialization-sh" "initialization script"
    mv "$PREFIX/tmp/initialization-sh" .
    chmod +x initialization-sh
    source ./initialization-sh "$1"
    rm -f initialization-sh
}

reinit_var() {
    echo "Configuration file is corrupted. How would you like to proceed? [1] Restore automatically [2] Edit manually [EXIT] Cancel "
    while true; do
        read -r choice
        if [ "${choice^^}" = "EXIT" ]; then
            echo "Exiting configuration editor"
            return 0
        fi
        case "$choice" in
            1)
                reinit var
                return 0
                ;;
            2)
                nano "$GQE_START/all_var.txt"
                clear
                return 0
                ;;
            *)
                clear
                echo "Invalid option; please try again or enter EXIT to exit"
                continue
                ;;
        esac
    done
}

if [ ! -f "$HOME/storage/shared/.gqe-start/all_var.txt" ]; then
    reinit_var
fi

if ! source "$HOME/storage/shared/.gqe-start/all_var.txt"; then
    echo "Failed to import environment variables! Please check whether the file /storage/emulated/0/.gqe-start/all_var.txt exists"
    exit 1
fi

