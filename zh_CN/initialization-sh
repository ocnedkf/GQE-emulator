rm -rf $WINEPREFIX
pkill -f termux-x11
termux-x11 :13 >/dev/null 2>&1 &
env WINEDLLOVERRIDES="mscoree=" DISPLAY=:13 grun $BOX64 wine wineboot -i >/dev/null 2>&1
pkill -f termux-x11

echo -e "\n正在配置 Wine...\n"
download_file https://v6.gh-proxy.org/https://github.com/ocnedkf/tfm/releases/download/v1.0.1-zh_cn/TFM.exe "e72e2eed325c10723288dfdd5b94d9e6abdacc85ff189308d5f7123557db53d6" "tfm.exe" "文件管理器"
mv $PREFIX/tmp/tfm.exe $WINEPREFIX/drive_c/windows/tfm.exe
download_file https://v6.gh-proxy.org/https://github.com/ocnedkf/GQE-emulator/releases/download/v0.3.2-beta/startmenulink-zh.tar.xz "79bbb5323c9d1e1be3873eab1edec34f3fee8bdaaf240f4652d6de6d6048ae85" "startmenulink-zh.tar.xz" "开始菜单快捷方式文件"
echo -e "\n正在解压 开始菜单快捷方式文件...\n"
tar -xf $PREFIX/tmp/startmenulink-zh.tar.xz -C $WINEPREFIX/drive_c/users/steamuser/AppData/Roaming/Microsoft/Windows/"Start Menu"
rm -f startmenulink-zh.tar.xz
download_file https://v6.gh-proxy.org/https://github.com/ocnedkf/GQE-emulator/releases/download/v0.3.2-beta/startmenu-v0.3.2.tar.xz "20193fb78daeaa1eedac5e1a3e69c4a6a55bc28575d143c591cd0ea05af287dd" "startmenu-v0.3.2.tar.xz" "开始菜单文件"
extract_file "开始菜单文件" "startmenu-v0.3.2.tar.xz" "$GQE_DATA/STARTMENU"

# download and extract InputBridge
download_file https://v6.gh-proxy.org/https://github.com/ocnedkf/GQE-emulator/releases/download/v0.1-beta/inputbridge.tar.xz "93c9da74b8c9cde3e595033e73bd49f0451cb9d5621aab76a652e0aecf1819af" "inputbridge.tar.xz" "InputBridge"
extract_file "InputBridge" "inputbridge.tar.xz" "$GQE_DATA"

echo -e "\n正在安装 InputBridge...\n"
echo -e "cd Z:\\home\\.gqe-data-v0.3\\InputBridge\\ \n.\install.bat\nexit" > install-ib.bat
grun $BOX64 wine cmd /c Z:\\home\\install-ib.bat >/dev/null 2>&1
rm install-ib.bat

# download mfc42 dll file
download_file https://v6.gh-proxy.org/https://github.com/ocnedkf/GQE-emulator/releases/download/v0.1-beta/mfc42.dll "40e83003f7d136276cd76fde17639f8cec04c3bc85d108446fa511aab1df0506" "mfc42.dll" "mfc42.dll"
