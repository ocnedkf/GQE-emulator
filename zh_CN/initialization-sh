echo -e "\n正在设置 DLL覆盖...\n"
dll_overrides > dllsetting.reg
echo "regedit /s Z:\\home\\dllsetting.reg" > set.bat
grun $BOX64 wine Z://home//set.bat >/dev/null 2>&1
rm -f dllsetting.reg

echo -e "\n正在配置启动脚本...\n"
rm -rf $GQE_CONFIG_PATH
mkdir -p $GQE_CONFIG_PATH
echo 'start /min Z:\\home\\.gqe-data-v0.3\\InputBridge\\ib.exe' > "$GQE_CONFIG_PATH/start-gqe-v0.3.bat"
echo 'start tfm.exe C:\\' >> "$GQE_CONFIG_PATH/start-gqe-v0.3.bat"

echo -e "\n正在初始化视觉环境...\n"
download_file https://v6.gh-proxy.org/https://github.com/ocnedkf/GQE-emulator/releases/download/v0.2-beta/wallpaper.bmp "d53a15d588b5bbe6a68d737c4a3d9ca93bf7dd6b75a7d4b5c9998ecdb12baa15" "wallpaper.bmp" "壁纸"
mv $PREFIX/tmp/wallpaper.bmp $WINEPREFIX/drive_c/wallpaper.bmp
wallpaper_reg > wallpapersetting.reg
echo "regedit /s Z:\\home\\wallpapersetting.reg" > set.bat
grun $BOX64 wine Z://home//set.bat >/dev/null 2>&1
rm -f wallpapersetting.reg set.bat

echo -e "\n正在创建配置文件...\n"
touch "$GQE_CONFIG_PATH"/{mesa_var_v.txt,mesa_var_f.txt}
var_all > $GQE_CONFIG_PATH/all_var.txt
echo "dxvk.hud = 1" > $GQE_CONFIG_PATH/dxvk_settings.ini
echo "virpipe" > $GQE_CONFIG_PATH/mesa_var.txt

echo "配置完成"
echo -e "\n初始化完成\n"

rm -f "$0"
