# 3 Wine 设置
gqe_wine_settings() {
    clear
    echo -e "1) DLL覆盖\n2) Wine 信息\n3) 返回"
    read -e -p "请输入选项 (1-3): " wine_choice
    case $wine_choice in
        1)
            echo ""
            while true; do
                read -p "请输入DLL文件名字 (或输入 'exit' 以返回): " dll_name

                if [ "$dll_name" = "exit" ] || [ "$dll_name" = "EXIT" ]; then
                    echo "返回上级菜单..."
                    return 0
                fi

                if [ -z "$dll_name" ]; then
                    echo "错误: DLL名称不能为空，请重新输入..."
                    continue
                fi

                read -p "请输入覆盖类型 (native/builtin/native,builtin): " dll_type
                if [ "$dll_type" != "native" ] && [ "$dll_type" != "builtin" ] && [ "$dll_type" != "native,builtin" ]; then
                    echo "错误: 覆盖类型无效，请输入 'native'、'builtin' 或 'native,builtin'"
                    continue
                fi

                echo "Windows Registry Editor Version 5.00" > dllset.reg
                echo "[HKEY_CURRENT_USER\\Software\\Wine\\DllOverrides]" >> dllset.reg
                echo "\"$dll_name\"=\"$dll_type\"" >> dllset.reg

                echo "regedit /s Z:\\home\\dllset.reg" > set.bat
                grun "$BOX64" wine64 Z://home//set.bat >/dev/null 2>&1
                rm -f dllset.reg set.bat

                echo "已设置 $dll_name 为 $dll_type"
            done
            ;;
        2)
            echo -e "Wine 信息\nWine 版本: 9.16-custom\nWine 前缀路径: $GQE_DATA/.wine\nWine 模式: Wow64\nWine 构建 by ocnedkf"
            ;;
        3)
            return 1
            ;;
        *)
            echo "无效选项，请重新选择。"
            ;;
    esac
}

# 4 盘符设置
gqe_drive_settings() {
    clear
    echo -e "1) 添加盘符\n2) 删除盘符\n3) 查看盘符\n4) 返回"
    local DOSDIR="${GQE_DATA}/.wine/dosdevices"
    read -e -p "请输入选项 (1-4): " drive_choice
    case $drive_choice in
        1)
            while true; do
                read -e -p "请输入盘符名称 (例如 D，或输入 EXIT 返回): " drive_letter
                if [ "${drive_letter^^}" = "EXIT" ]; then
                    return 0
                fi
                read -e -p "请输入盘符路径 (例如 /storage/emulated/0，或输入 EXIT 返回): " drive_path
                if [ "${drive_path^^}" = "EXIT" ]; then
                    return 0
                fi
                if [ -z "$drive_letter" ] || [ -z "$drive_path" ]; then
                    echo "错误: 盘符名称和路径不能为空，请重新输入..."
                    continue
                fi

                if ! [[ "$drive_letter" =~ ^[A-Za-z]$ ]]; then
                    echo "错误: 盘符名称必须是单个英文字母（如 D) 请重新输入..."
                    continue
                fi

                drive_letter=${drive_letter^^}
                link="$DOSDIR/${drive_letter}:"
                if [ -L "$link" ] || [ -e "$link" ]; then
                    echo "错误: 盘符 $drive_letter 已存在，请选择其他盘符名称..."
                    continue
                fi

                ln -s "$drive_path" "$link"
                echo "已添加盘符 $drive_letter 映射到 $drive_path"
                return 0
            done
            ;;
        2)
            while true; do
                read -e -p "请输入要删除的盘符名称 (例如 D，或输入 EXIT 返回): " drive_letter

                if [ "${drive_letter^^}" = "EXIT" ]; then
                    return 0
                fi
                if [ -z "$drive_letter" ]; then
                    echo "错误: 盘符名称不能为空..."
                    continue
                fi
                drive_letter=${drive_letter^^}
                link="$DOSDIR/${drive_letter}:"

                if [ ! -L "$link" ]; then
                    echo "错误: 盘符 $drive_letter 不存在..."
                    continue
                fi

                read -e -p "确认删除盘符 $drive_letter ? (y/n): " confirm
                if [[ "$confirm" =~ ^[Yy]$ ]]; then
                    rm -f "$link"
                    echo "已删除盘符 $drive_letter"
                else
                    echo "取消删除盘符 $drive_letter"
                    return 0
                fi
                return 0
            done
            ;;
        3)
            echo "当前盘符列表:"
            for link in "$DOSDIR"/*; do
                if [ -L "$link" ]; then
                    drive_letter=$(basename "$link" | sed 's/:$//')
                    drive_path=$(readlink "$link")
                    echo "盘符 $drive_letter 映射到 $drive_path"
                fi
            done
            ;;
        4)
            return 1
            ;;
        *)
            echo "无效选项，请重新选择。"
            ;;
    esac
}

# 5 其他设置
gqe_other_settings() {
    while true; do
        clear
        echo -e "更多设置\n\n1) 时区设置\n2) 配置设置\n3) 后端设置\n4) 壁纸设置\n5) 返回"
        read -e -p "请输入选项 (1-5): " other_choice
        case $other_choice in
        1)
            clear
            echo_time_info
            read -p "请输入时区ID: " timezone
            if [ -z "${timezone}" ]; then
                echo -e "\033[31m错误: 未输入时区，请重试\033[0m"
                continue
            else
                echo "${timezone}" > "$GQE_DATA/timezone.txt"
                clear
                echo "时区已保存为: ${timezone}"
            fi
            ;;
        2)
            local config_file

            if [ ! -f "$PREFIX/bin/nano" ]; then
                clear
                echo -e "\nnano编辑器未安装，尝试安装...\n"
                pkg i --reinstall nano
                if [ ! -f "$PREFIX/bin/nano" ]; then
                    echo -e "安装失败，请重试\n"
                    continue
                fi
            fi
            while true; do
                clear
                echo -e "1) 编辑 dxvk_settings.ini ( DXVK 配置文件 )\n2) 编辑 all_var.txt ( GQE 环境变量配置文件 )\n3) 编辑 start-gqe-v0.4.bat ( GQE Wine 启动脚本 )\n4) 返回"
                read -e -p "请输入选项 (1-4): " config_file
                GQE_START="$HOME/storage/shared/.gqe-start"
                case "$config_file" in
                    1)
                        if [ ! -f "$GQE_START/dxvk_settings.ini" ]; then
                            touch "$GQE_START/dxvk_settings.ini"
                        fi
                        nano "$GQE_START/dxvk_settings.ini"

                        clear
                        continue
                        ;;
                    2)
                        if [ ! -f "$GQE_START/all_var.txt" ]; then
                            reinit_var
                        fi
                        nano "$GQE_START/all_var.txt"
                        clear
                        continue
                        ;;
                    3)
                        if [ ! -f "$GQE_START/start-gqe-v0.4.bat" ]; then
                            touch "$GQE_START/start-gqe-v0.4.bat"
                        fi
                        nano "$GQE_START/start-gqe-v0.4.bat"
                        clear
                        continue
                        ;;
                    4)
                        break
                        ;;
                    *)
                        echo "无效的选择，请重试或输入 EXIT 以退出"
                        continue
                        ;;
                esac
            done
            ;;
        3)
            while true; do
                echo -e "1) WineD3D 后端\n2) Virgl 后端\n3) 返回"
                read -e -p "选择数字以继续...(1/2/3 或 EXIT 以退出) " choose_backend
            if [ "${choose_backend^^}" = "EXIT" ]; then
                echo "退出后端设置"
                clear
                break
            fi
            case "$choose_backend" in
                1)
                    clear
                    while true; do
                        read -p 'choose a backend... (gl/vulkan/no3d or "exit" to cancel): ' renderer
                        if [ "${renderer^^}" = "EXIT" ]; then
                            echo "退出后端设置"
                            break
                        fi
                        if [ "$renderer" = "gl" ] || [ "$renderer" = "vulkan" ] || [ "$renderer" = "no3d" ]; then
                            cd "$HOME"
                            echo "Windows Registry Editor Version 5.00" > dllset.reg
                            echo "[HKEY_CURRENT_USER\\Software\\Wine\\Direct3D]" >> dllset.reg
                            echo "\"renderer\"=\"$renderer\"" >> dllset.reg
                            echo -e "\n[HKEY_CURRENT_USER\\WoW6432Node\\Software\\Wine\\Direct3D]" >> dllset.reg
                            echo "\"renderer\"=\"$renderer\"" >> dllset.reg

                            echo "regedit /s Z:\\home\\dllset.reg" > set.bat

                            if grun "$BOX64" wine64 Z:\\home\\set.bat >/dev/null 2>&1; then
                                echo "完成!"
                                rm -f dllset.reg set.bat
                                break
                            else
                                clear
                                echo "设置后端失败，请检查 Wine 完整性"
                                rm -f dllset.reg set.bat
                                break
                            fi
                        else
                            clear
                            echo -e "你选择了不存在的选项，请重试"
                        fi
                    done

                    ;;
                2)
                    while true; do
                        echo -e "1) 标准\n2) 安卓特别版\n3) 退出"
                        read -e -p "输入数字以选择...(1/2/3) " choose_virgl_backend
                    if [ "$choose_virgl_backend" = "1" ]; then
                        if ! command -v virgl_test_server >/dev/null 2>&1; then
                            read -p "此后端尚未安装，是否现在进行安装? [y/n] " choose
                            if [ "${choose^^}" != "Y" ]; then
                                echo "已取消后端安装"
                                break
                            fi
                            echo "正在安装..."
                            pkg i --reinstall virglrenderer >/dev/null 2>&1
                            if ! command -v virgl_test_server >/dev/null 2>&1; then
                                echo "安装失败，未找到 virgl_test_server"
                                break
                            fi
                        fi
                        echo "virglrenderer" > "$GQE_DATA/virgl_backend.txt"
                        echo "切换完成"
                        break
                    elif [ "$choose_virgl_backend" = "2" ]; then
                        if ! command -v virgl_test_server_android >/dev/null 2>&1; then
                            read -p "此后端尚未安装，是否现在进行安装? [y/n] " choose
                            if [ "$choose" != "y" ]; then
                                echo "已取消后端安装"
                                break
                            fi
                            echo "正在安装..."
                            pkg i --reinstall virglrenderer >/dev/null 2>&1
                            if ! command -v virgl_test_server_android >/dev/null 2>&1; then
                                echo "安装失败，未找到 virgl_test_server_android"
                                break
                            fi
                        fi
                        echo "virglrenderer_android" > "$GQE_DATA/virgl_backend.txt"
                        echo "切换完成"
                        break
                    elif [ "$choose_virgl_backend" = "3" ]; then
                        echo "退出后端设置"
                        break
                    fi
                        echo "无效选项，请重新选择。"
                    done
                    ;;
                3)
                    break
                    ;;
                *)
                    echo "无效选项，请重新选择。"
                    ;;
            esac
            done
            ;;
        4)
            if [ ! -f "$GQE_DATA/.wine/drive_c/wallpaper.bmp" ]; then
                echo "未设置壁纸"
            else
                if sha256sum --status -c <<< "d53a15d588b5bbe6a68d737c4a3d9ca93bf7dd6b75a7d4b5c9998ecdb12baa15  $GQE_DATA/.wine/drive_c/wallpaper.bmp" >/dev/null 2>&1; then
                    echo "目前壁纸为默认壁纸"
                else
                    echo "目前壁纸为自定义壁纸"
                fi
            fi
            while true; do
                read -e -p "请输入壁纸文件路径 (BMP 格式, 或输入 EXIT 以退出): " wallpaper_path
                if [ "${wallpaper_path^^}" = "EXIT" ]; then
                    echo "退出壁纸设置"
                    break
                fi
                if [ -z "$wallpaper_path" ]; then
                    echo "错误: 路径为空，请重试或输入 EXIT 以退出"
                    continue
                fi
                if [ -f "$wallpaper_path" ]; then
                    cp "$wallpaper_path" "$GQE_DATA/.wine/drive_c/wallpaper.bmp"
                    echo "壁纸路径已设置为: $wallpaper_path"
                    break
                else
                    echo "错误: 文件不存在，请重试或输入 EXIT 以退出"
                    continue
                fi
            done
            ;;
        5)
            return 1
            ;;
        *)
            echo "无效选项，请重新选择。"
            continue
            ;;
    esac
    done
}

