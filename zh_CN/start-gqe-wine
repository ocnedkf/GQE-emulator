#!/data/data/com.termux/files/usr/bin/env bash

trap 'clear; echo "关闭中..."; if ps a | grep -q "[w]ine"; then /data/data/com.termux/files/usr/bin/kill-gqe; fi; exit 130' 2 3

export HOME="/data/data/com.termux/files/home"
if [ ! -d "$HOME/storage" ]; then
    echo -e "找不到外部存储！检查你的存储权限"
    exit 1
fi

export PREFIX="/data/data/com.termux/files/usr"
download_file() {
    local url="$1"
    local hash_value="$2"
    local file_name="$3"
    local echo_file_name="$4"
    echo -e "\n正在下载 $echo_file_name...\n"
    rm -f "$PREFIX/tmp/$file_name"

    if ! wget --quiet --show-progress -c -O "$PREFIX/tmp/$file_name" "$url"; then
        echo -e "\n\033[31m错误: 无法下载 $echo_file_name, 检查网络!\033[0m\n"
        exit 1
    fi

    sha256sum --status -c <<< "$hash_value  $PREFIX/tmp/$file_name"
    if [ $? -ne 0 ]; then
        echo -e "\n\033[31m错误: 检验 $file_name 哈希值失败, 请检查文件完整性\033[0m\n"
        rm -f "$PREFIX/tmp/$file_name"
        exit 1
    fi
}

extract_file() {
    local echo_file_name="$1"
    local file_name="$2"
    local dest_dir="$3"
    echo -e "\n正在解压 $echo_file_name...\n"
    mkdir -p "$dest_dir"
    if tar -xJf "$PREFIX/tmp/$file_name" -C "$dest_dir" >/dev/null 2>&1; then
        rm -f "$PREFIX/tmp/$file_name"
    else
        echo -e "\n\033[31m错误: 解压 $file_name 失败, 请再试一次\033[0m\n"
        exit 1
    fi
}

