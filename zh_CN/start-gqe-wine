reinit() {
    download_file "https://raw.githubusercontent.com/ocnedkf/GQE-emulator/refs/heads/v0.4-beta/initialization-wine-sh" "ea5e1bf071a8f62bf1898dfd07eea53ee44cdbcb47d78761e8dd1ce78c9b0c59" "initialization-sh" "初始化脚本"
    mv "$PREFIX/tmp/initialization-sh" .
    chmod +x initialization-sh
    source ./initialization-sh "$1"
    rm -f initialization-sh
}

reinit_var() {
    echo "配置文件损坏？你想要选择哪种方式？ [1] 自动恢复 [2] 手动编辑 [EXIT] 取消 "
    while true; do
        read -r choice
        if [ "${choice^^}" = "EXIT" ]; then
            echo "退出配置编辑"
            return 0
        fi
        case "$choice" in
            1)
                reinit var
                return 0
                ;;
            2)
                nano "$GQE_START/all_var.txt"
                clear
                return 0
                ;;
            *)
                clear
                echo "无效的选项, 请重试或输入 EXIT 以退出"
                continue
                ;;
        esac
    done
}

if [ ! -f "$HOME/storage/shared/.gqe-start/all_var.txt" ]; then
